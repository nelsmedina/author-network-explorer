{
  "manifest_version": 3,
  "name": "Author Network Explorer",
  "version": "1.1",
  "description": "Visualize scientific author collaboration networks using OpenAlex data",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://api.openalex.org/*",
    "https://scholar.google.com/*",
    "https://pubmed.ncbi.nlm.nih.gov/*",
    "https://arxiv.org/*",
    "https://www.nature.com/*",
    "https://ieeexplore.ieee.org/*",
    "https://dl.acm.org/*",
    "https://www.science.org/*",
    "https://www.cell.com/*",
    "https://www.sciencedirect.com/*",
    "https://www.pnas.org/*",
    "https://www.biorxiv.org/*",
    "https://www.medrxiv.org/*",
    "https://elifesciences.org/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Author Network Explorer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://scholar.google.com/*",
        "https://pubmed.ncbi.nlm.nih.gov/*",
        "https://arxiv.org/*",
        "https://www.nature.com/*",
        "https://ieeexplore.ieee.org/*",
        "https://dl.acm.org/*",
        "https://www.science.org/*",
        "https://www.cell.com/*",
        "https://www.sciencedirect.com/*",
        "https://www.pnas.org/*",
        "https://www.biorxiv.org/*",
        "https://www.medrxiv.org/*",
        "https://elifesciences.org/*"
      ],
      "js": [
        "content-script.js"
      ],
      "css": [
        "content-style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/ane-icon.svg",
        "icons/ane-collection-icon.svg"
      ],
      "matches": [
        "https://scholar.google.com/*",
        "https://pubmed.ncbi.nlm.nih.gov/*",
        "https://arxiv.org/*",
        "https://www.nature.com/*",
        "https://ieeexplore.ieee.org/*",
        "https://dl.acm.org/*",
        "https://www.science.org/*",
        "https://www.cell.com/*",
        "https://www.sciencedirect.com/*",
        "https://www.pnas.org/*",
        "https://www.biorxiv.org/*",
        "https://www.medrxiv.org/*",
        "https://elifesciences.org/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "options_page": "options.html"
}
